@page "/test-draggable-list"
@rendermode InteractiveServer
@layout MainLayout
@using Microsoft.JSInterop
@implements IAsyncDisposable

@namespace Server.UI.Components

<PageTitle>Test Draggable List</PageTitle>



<h1>Menu Editor Test</h1>
<p>Drag items from the left panel into the menu tree on the right. Nest them by dropping onto children areas.</p>

<div id="menu-editor-root" class="flex flex-row gap-8 w-full">
    <div class="border p-4 rounded w-64 shrink-0">
        <h2 class="font-semibold mb-2">Not in Menu</h2>
        <div id="not-in-menu-list">
            <div class="tree-node" data-id="3">
                <div class="node-row">
                    <span class="drag-handle">::</span>
                    <span class="node-label">Blog</span>
                </div>
                <div class="tree-children"></div>
            </div>
            <div class="tree-node" data-id="4">
                <div class="node-row">
                    <span class="drag-handle">::</span>
                    <span class="node-label">Career</span>
                </div>
                <div class="tree-children"></div>
            </div>
            <div class="tree-node" data-id="5">
                <div class="node-row">
                    <span class="drag-handle">::</span>
                    <span class="node-label">Something</span>
                </div>
                <div class="tree-children"></div>
            </div>
        </div>
    </div>
    <div class="border p-4 rounded flex-1">
        <h2 class="font-semibold mb-2">In Menu</h2>
        <div id="in-menu-tree">
            <div class="tree-node" data-id="1">
                <div class="node-row">
                    <span class="drag-handle">::</span>
                    <span class="node-label">Home</span>
                </div>
                <div class="tree-children">
                    <div class="tree-node" data-id="1-1">
                        <div class="node-row">
                            <span class="drag-handle">::</span>
                            <span class="node-label">About</span>
                        </div>
                        <div class="tree-children"></div>
                    </div>
                    <div class="tree-node" data-id="1-2">
                        <div class="node-row">
                            <span class="drag-handle">::</span>
                            <span class="node-label">Contact</span>
                        </div>
                        <div class="tree-children"></div>
                    </div>
                </div>
            </div>
            <div class="tree-node" data-id="2">
                <div class="node-row">
                    <span class="drag-handle">::</span>
                    <span class="node-label">News</span>
                </div>
                <div class="tree-children">
                    <div class="tree-node" data-id="2-1">
                        <div class="node-row">
                            <span class="drag-handle">::</span>
                            <span class="node-label">Events</span>
                        </div>
                        <div class="tree-children"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<h2 class="mt-6 font-semibold">Current Menu JSON</h2>
<pre class="bg-gray-100 p-4 rounded text-sm overflow-auto">@MenuJson</pre>

<style>
    #not-in-menu-list .tree-children {
        display: none; /* nodes in the flat list have no visible children area */
    }

    .tree-children {
        margin-left: 1rem;
        padding: 0.35rem 0 0.35rem 0.5rem;
        border-left: 2px solid #d1d5db;
        min-height: 1.5rem;
    }

    .tree-node {
        margin: 0.35rem 0;
    }

    .node-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        padding: 0.5rem 0.75rem;
        background: #fffbeb;
        cursor: default;
    }

    .drag-handle {
        cursor: grab;
        user-select: none;
        color: #6b7280;
        font-weight: 700;
    }

    .sortable-ghost .node-row {
        opacity: 0.4;
    }

    .sortable-drag .node-row {
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
    }
</style>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private IJSObjectReference? _module;
    private DotNetObjectReference<TestDraggableList>? _selfRef;
    private string MenuJson = "[]";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./SortableJSTreeViewer/main.treeviewer.js");
        _selfRef = DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync("initMenuEditor", "menu-editor-root", _selfRef);
    }

    [JSInvokable]
    public Task OnMenuChanged(string treeJson)
    {
        MenuJson = treeJson;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroyMenuEditor");
            }
            catch (JSDisconnectedException) { } // circuit already gone — safe to swallow

            await _module.DisposeAsync();
        }

        _selfRef?.Dispose();
    }
}