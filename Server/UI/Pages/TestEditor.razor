@page "/test-editor"
@rendermode InteractiveServer
@layout MainLayout
@using Flurl.Http
@using Server.API.Routes.Page.POST;

<PageTitle>Test Editor</PageTitle>

<h1>Test Editor</h1>

<p>Just for testing the Quill editor component with the API.</p>

<p>SV</p>
<QuillEditor @bind-Value="ContentSV" />

<p>EN</p>
<QuillEditor @bind-Value="ContentEN" />

<button @onclick="SaveContentAsync">Save</button>

@code {
    private string ContentSV = "<p>Hej världen!</p>";
    private string ContentEN = "<p>Hello, World!</p>";

    private async Task SaveContentAsync()
    {
        PostPageRequest request = new PostPageRequest
        {
            Type = "Page",
            SavedAt = DateTime.UtcNow,
            Translations = new Dictionary<string, PostTranslationContentPageDTO>
            {
                { "sv", new PostTranslationContentPageDTO { Content = ContentSV } },
                { "en", new PostTranslationContentPageDTO { Content = ContentEN } }
            }
        };

        try
        {
            IFlurlResponse? response = await "http://localhost:5126/api/page".PostJsonAsync(request);
            if (response.StatusCode == 200 || response.StatusCode == 201)
            {
                Console.WriteLine("Content saved successfully!");
            }
            else
            {
                Console.WriteLine($"Failed to save content. Status code: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving content: {ex.Message}");
        }
    }
    
}


