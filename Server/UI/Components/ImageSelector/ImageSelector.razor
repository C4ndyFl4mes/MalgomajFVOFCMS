@using Server.API.Enums
@using Server.API.Routes.ImageFile.GET
@using Server.UI.Components.ImageTabs
@inherits ImageSelectorBase

<div>
    <ImageTabs AllowedImageTabs="AllowedImageTabs" OnValidationErrors="@(v => ValidationErrorsOfImageRetrieval = v)"
               OnTabSelected="(images) => { ImagesOfSelectedTab = images; StateHasChanged(); }" />
    @if (ValidationErrorsOfImageRetrieval.Keys.Contains("Images"))
    {
        <ul class="error text-center">
            @foreach (string error in ValidationErrorsOfImageRetrieval["Images"])
            {
                <p>@error</p>
            }
        </ul>
    }
    else if (ImagesOfSelectedTab.Item2.Any())
    {
        <div class="@(ImagesOfSelectedTab.Item1 != ImageType.Icon ? "grid grid-cols-4" : "flex flex-wrap") gap-4 pt-4">
            @foreach (ImageDTO image in ImagesOfSelectedTab.Item2)
            {
                string basePath = $"/images/{image.Id}";
                var (width, height) = DimensionsForImageType[ImagesOfSelectedTab.Item1];
                string altText = image.Translations.TryGetValue("sv", out string? svAlt) &&
                !string.IsNullOrWhiteSpace(svAlt)
                    ? svAlt
                    : "Bild";
                @if (image.Type != ImageType.Icon.ToString())
                {
                    <picture class="cursor-pointer" @onclick="() => SelectImage(image, width, height)">
                        <source media="max-width: 600px" type="image/webp" srcset="@($"{basePath}/webp/mobile.webp")" />
                        <source media="min-width: 601px" type="image/webp" srcset="@($"{basePath}/webp/desktop.webp")" />
                        <source media="max-width: 600px" srcset="@($"{basePath}/jpg/mobile.jpg")" />
                        <source media="min-width: 601px" srcset="@($"{basePath}/jpg/desktop.jpg")" />
                        <img src="@($"{basePath}/jpg/desktop.jpg")" width="@width" height="@height" alt="@altText" loading="lazy"
                             decoding="async"
                             class="object-cover rounded-lg shadow-md @CSSClassesForImageType[ImagesOfSelectedTab.Item1]" />
                    </picture>
                }
                else
                {
                    <img src="@($"{basePath}/svg/icon.svg")" width="150" height="150" alt="@altText" loading="lazy"
                         decoding="async"
                         class="cursor-pointer object-cover rounded-lg shadow-md @CSSClassesForImageType[ImagesOfSelectedTab.Item1]"
                         @onclick="() => SelectImage(image, width, height)" />
                }
            }
        </div>
    }
    else
    {
        <p class="text-center text-gray-500 mt-4">Inga bilder att visa.</p>
    }
</div>