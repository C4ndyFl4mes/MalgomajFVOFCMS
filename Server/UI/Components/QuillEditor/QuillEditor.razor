@using Server.UI.Components.ImageSelector
@using Server.UI.Components.Overlay
@inherits QuillEditorBase

<div class="w-full mx-auto min-h-100 border-2 border-slate-100 rounded-2xl overflow-hidden mb-20 p-4">
    <div id="@EditorId"></div>
</div>


<Overlay IsOpen="IsImageSelectorOpen" Changed="@(v => IsImageSelectorOpen = v)">
    <ImageSelector OnImageSelected="@(async (inspectionModel) => await HandleImageSelected(inspectionModel))" />
</Overlay>