@inherits TranslationTextareaBase

<div class="relative flex gap-x-1 w-full">
    <div class="flex flex-col">
        <label for="@LanguageCodeFieldId" class="hidden">Språkkod:</label>
        <input type="text" maxlength="2" id="@LanguageCodeFieldId" name="@LanguageCodeFieldId"
               disabled="@ProtectedLanguageCode" @bind="@Field.LanguageCode" @bind:event="oninput"
               @bind:after="@(async () => { if (!ProtectedLanguageCode) await OnChangeField.InvokeAsync(Field); })"
               class="bg-slate-100 border rounded px-2 py-1 w-14 text-center" />
    </div>
    <div class="flex w-[inherit]">
        <label for="@TextFieldId" class="hidden">Text:</label>
        <textarea id="@TextFieldId" name="@TextFieldId" @bind="@Field.Text" @bind:event="oninput"
                  @bind:after="@(async () => await OnChangeField.InvokeAsync(Field))"
                  class="bg-slate-100 border @RoundedClass px-2 py-1 w-[inherit] h-32 resize-none"></textarea>
        @if (!ProtectedLanguageCode)
        {
            <button type="button"
                    class="cursor-pointer bg-red-500 text-white rounded-r w-8 flex justify-center items-center hover:brightness-95 active:brightness-90 duration-200 h-full"
                    @onclick="@(async () => await OnRemoveField.InvokeAsync(Field))">
                <img src="/icons/remove.svg" alt="Remove" class="w-5 h-5" />
            </button>
        }
    </div>
    
</div>